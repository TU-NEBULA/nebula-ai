# 환경 설정
ENVIRONMENT=development
DEBUG=true

# PostgreSQL RDS 설정
POSTGRES_HOST=your-rds-endpoint.amazonaws.com
POSTGRES_PORT=5432
POSTGRES_USER=your_username
POSTGRES_PASSWORD=your_password
POSTGRES_DB=nebula_ai_dev

# 데이터베이스 연결 풀 설정
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=0
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600
DB_SSL_MODE=require

# 모니터링 설정
ENABLE_METRICS=true
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=
METRICS_COLLECTION_INTERVAL=15

# 기존 설정들
HUGGINGFACEHUB_API_TOKEN=your_token
EMBEDDING_MODEL_NAME=your_model
MODEL_NAME=your_model
CACHE_DIR=./cache
OPENAI_API_KEY=your_openai_key
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_MODEL=gpt-4
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT=30.0
ANTHROPIC_API_KEY=your_anthropic_key
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=your_endpoint
LANGSMITH_API_KEY=your_key
LANGSMITH_PROJECT=your_project
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_KEY_ID=your_secret_key
REGION=ap-northeast-2
BUCKET_NAME=your_bucket
CHROMA_DB_URI=./chroma_db

# Redis 설정 (Docker 컨테이너 사용)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

# RabbitMQ 설정 (EC2 인스턴스 사용)
RABBITMQ_HOST=your-ec2-instance-ip-or-domain
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=your_username
RABBITMQ_PASSWORD=your_password
EXTRACT_REQ_QUEUE=extract_request
CHAT_REQ_QUEUE=chat_request
BOOKMARK_SAVE_QUEUE=bookmark_save
BOOKMARK_RELATIONSHIP_QUEUE=bookmark_relationship

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password
BASE_THUMBNAIL=https://your-domain.com/thumbnail

# Spring Boot 서버 설정
SPRING_BOOT_BASE_URL=http://localhost:8080
SPRING_BOOT_TIMEOUT=30.0 